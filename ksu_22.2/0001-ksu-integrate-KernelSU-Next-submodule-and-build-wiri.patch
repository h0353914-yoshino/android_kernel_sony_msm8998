From 8ddb9b59f269672c60b6ac98ce95645840a2870d Mon Sep 17 00:00:00 2001
From: h <h0353914@gmail.com>
Date: Sun, 11 Oct 2026 02:19:05 +0800
Subject: [PATCH 1/3] ksu: integrate KernelSU-Next submodule and build wiring

Change-Id: Ief67be533c3afc92cac256999db3228b6d48a116
---
 .gitmodules                            |  4 ++++
 KernelSU-Next                          |  1 +
 drivers/Kconfig                        |  2 ++
 drivers/Makefile                       |  5 +++++
 drivers/kernelsu                       |  1 +
 include/linux/kernelsu_legacy_compat.h | 14 ++++++++++++++
 6 files changed, 27 insertions(+)
 create mode 100644 .gitmodules
 create mode 160000 KernelSU-Next
 create mode 120000 drivers/kernelsu
 create mode 100644 include/linux/kernelsu_legacy_compat.h

diff --git a/.gitmodules b/.gitmodules
new file mode 100644
index 000000000000..fab1cd075aa9
--- /dev/null
+++ b/.gitmodules
@@ -0,0 +1,4 @@
+[submodule "KernelSU-Next"]
+	path = KernelSU-Next
+	url = https://github.com/KernelSU-Next/KernelSU-Next.git
+	branch = legacy
diff --git a/KernelSU-Next b/KernelSU-Next
new file mode 160000
index 000000000000..c1d5d767d348
--- /dev/null
+++ b/KernelSU-Next
@@ -0,0 +1 @@
+Subproject commit c1d5d767d348b8782a1403a6607a78090b41d705
diff --git a/drivers/Kconfig b/drivers/Kconfig
index 4051a164c2eb..585d21362f1d 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -214,4 +214,6 @@ source "drivers/sensors/Kconfig"
 
 source "drivers/tee/Kconfig"
 
+source "drivers/kernelsu/Kconfig"
+
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index d3f690ab5b27..100c389babe8 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -185,3 +185,8 @@ obj-$(CONFIG_BIF)		+= bif/
 obj-$(CONFIG_SENSORS_SSC)	+= sensors/
 obj-$(CONFIG_ESOC)              += esoc/
 obj-$(CONFIG_TEE)		+= tee/
+obj-$(CONFIG_KSU) += kernelsu/
+
+ifeq ($(CONFIG_KSU),y)
+subdir-ccflags-y += -include $(srctree)/include/linux/kernelsu_legacy_compat.h
+endif
diff --git a/drivers/kernelsu b/drivers/kernelsu
new file mode 120000
index 000000000000..b32a3654a683
--- /dev/null
+++ b/drivers/kernelsu
@@ -0,0 +1 @@
+../KernelSU-Next/kernel
\ No newline at end of file
diff --git a/include/linux/kernelsu_legacy_compat.h b/include/linux/kernelsu_legacy_compat.h
new file mode 100644
index 000000000000..9c5b4107fa2d
--- /dev/null
+++ b/include/linux/kernelsu_legacy_compat.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_KERNELSU_LEGACY_COMPAT_H
+#define _LINUX_KERNELSU_LEGACY_COMPAT_H
+
+/* KernelSU-Next legacy uses helpers introduced after Linux 4.4. */
+#ifndef ALIGN_DOWN
+#define ALIGN_DOWN(x, a) ((x) & ~((typeof(x))(a) - 1))
+#endif
+
+#ifndef __nocfi
+#define __nocfi
+#endif
+
+#endif /* _LINUX_KERNELSU_LEGACY_COMPAT_H */
-- 
2.43.0

